# Set these in Vercel Project Settings → Environment Variables (Production + Preview + Development).

# Auto-injected once you connect the Neon Postgres integration to this Vercel project:
DATABASE_URL=

# Generate with: openssl rand -base64 32
JWT_SECRET=

# Auto-injected once you connect the Vercel Blob integration to this project:
BLOB_READ_WRITE_TOKEN=

# A password of your choosing — required by POST /api/setup so random people can't run it.
SETUP_TOKEN=
